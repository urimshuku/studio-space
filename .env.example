# Copy this file to .env and fill in your values.
# Restart the dev server (npm run dev) after changing .env.

# Supabase (required for donation checkout and venue booking form)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Functions (Supabase secrets — NOT in this file) ---
# Do not put server-only values in Vite env; they would be exposed in the client bundle.
#
# PUBLIC_APP_URL — public site origin, no trailing slash (e.g. https://www.studiospace.community).
#   Set in Dashboard → Edge Functions → Secrets or: supabase secrets set PUBLIC_APP_URL=...
#   Drives unsubscribe / email-preferences links in emails. If footers have no links, check this first.
#
# RESEND_API_KEY, BOOKING_*, PAYSERA_*, etc. — see docs/EDGE-SECRETS.md and supabase/.env.secrets.example

# Venue booking calls Edge Function: POST /functions/v1/book-venue
# In Supabase Dashboard → Edge Functions → book-venue → Secrets, set at least:
#   SUPABASE_SERVICE_ROLE_KEY (recommended for DB inserts; anon alone may fail if RLS has no insert policy)
#   RESEND_API_KEY
# Edge Function secrets (set in Supabase Dashboard or: npx supabase secrets set KEY=value):
#   RESEND_API_KEY
#   BOOKING_ADMIN_EMAIL
#   BOOKING_FROM_EMAIL (optional)
# SUPABASE_SERVICE_ROLE_KEY is usually already present for other functions.
